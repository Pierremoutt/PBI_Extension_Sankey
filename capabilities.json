{
  "dataRoles": [
    {
      "displayName": "Category Data",
      "name": "category",
      "kind": "Grouping"
    },
    {
      "displayName": "Measure Data",
      "name": "measure",
      "kind": "Measure"
    }
  ],

  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {}
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
  "privileges": [],
  "objects": {
    "enableAxis": {
      "properties": {
        "show": {
          "type": {
            "bool": true
          }
        },
        "fill": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "colorSelector": {
      "properties": {
        "linkColorSource": {
          "displayName": "Link Color Source",
          "type": {
            "enumeration": [{ "value": "source" }, { "value": "target" }]
          }
        }
      }
    },

    "nodeSettings": {
      "displayName": "Nodes",
      "properties": {
        "nodeWidth": {
          "displayName": "Width",
          "type": {
            "numeric": true
          }
        },
        "nodePadding": {
          "displayName": "Padding",
          "type": {
            "numeric": true
          }
        }
      }
    },

    "nodeColorSettings": {
      "displayName": "Node Color Mode",
      "properties": {
        "colorMode": {
          "displayName": "Color Mode",
          "type": {
            "enumeration": [
              { "value": "fixed", "displayName": "Fixed Color" },
              { "value": "byCategory", "displayName": "By Category" },
              { "value": "byValue", "displayName": "By Value" },
              { "value": "customPalette", "displayName": "Custom Palette" }
            ]
          }
        },
        "fixedColor": {
          "displayName": "Fixed Node Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "paletteColor1": {
          "displayName": "Custom Palette Color 1",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "paletteColor2": {
          "displayName": "Custom Palette Color 2",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    }
  }
}
