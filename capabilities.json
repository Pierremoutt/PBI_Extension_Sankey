{
  "dataRoles": [
    {
      "displayName": "Category Data",
      "name": "category",
      "kind": "Grouping"
    },
    {
      "displayName": "Measure Data",
      "name": "measure",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "for": { "in": "category" },
          "dataReductionAlgorithm": { "top": {} }
        },
        "values": {
          "select": [{ "bind": { "to": "measure" } }]
        }
      }
    }
  ],
  "privileges": [],
  "objects": {
    "columnHeaders": {
      "displayName": "Column Headers",
      "properties": {
        "show": {
          "displayName": "Show Headers",
          "type": { "bool": true }
        },
        "fontColor": {
          "displayName": "Font Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "fontSize": {
          "displayName": "Text Size",
          "type": { "formatting": { "fontSize": true } }
        },
        "fontFamily": {
          "displayName": "Font Family",
          "type": { "formatting": { "fontFamily": true } }
        }
      }
    },
    "linkSettings": {
      "displayName": "Links",
      "properties": {
        "linkColorSource": {
          "displayName": "Link Color Source",
          "type": {
            "enumeration": [
              { "value": "source", "displayName": "Source Node" },
              { "value": "target", "displayName": "Target Node" },
              { "value": "gradient", "displayName": "Gradient (Future)" }
            ]
          }
        },
        "fillOpacity": {
          "displayName": "Opacity",
          "type": { "numeric": true }
        }
      }
    },
    "nodeSettings": {
      "displayName": "Nodes",
      "properties": {
        "nodeWidth": {
          "displayName": "Width",
          "type": { "numeric": true }
        },
        "nodePadding": {
          "displayName": "Vertical Padding",
          "type": { "numeric": true }
        },
        "stroke": {
          "displayName": "Stroke Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "strokeWidth": {
          "displayName": "Stroke Width",
          "type": { "numeric": true }
        }
      }
    },
    "dataLabels": {
      "displayName": "Data Labels",
      "properties": {
        "show": {
          "displayName": "Show",
          "type": { "bool": true }
        },
        "color": {
          "displayName": "Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "fontSize": {
          "displayName": "Text Size",
          "type": { "formatting": { "fontSize": true } }
        },
        "fontFamily": {
          "displayName": "Font Family",
          "type": { "formatting": { "fontFamily": true } }
        }
      }
    },
    "nodeColorSettings": {
      "displayName": "Node Colors",
      "properties": {
        "colorMode": {
          "displayName": "Color Mode",
          "type": {
            "enumeration": [
              { "value": "fixed", "displayName": "Fixed Color" },
              { "value": "byCategory", "displayName": "By Category" },
              { "value": "byValue", "displayName": "By Value" },
              { "value": "customPalette", "displayName": "Custom Palette" }
            ]
          }
        },
        "fixedColor": {
          "displayName": "Fixed Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "paletteColor1": {
          "displayName": "Gradient Start / Color 1",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "paletteColor2": {
          "displayName": "Gradient End / Color 2",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "fill": {
          "displayName": "Specific Node Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    }
  }
}
